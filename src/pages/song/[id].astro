---
import Layout from '../../layouts/Layout.astro';
import { sql } from '../../db';
import { highlighterPromise } from '../../utils/highlighter';

export const prerender = false;

const { id } = Astro.params;

const [song] = await sql`
    SELECT s.*, b.name as band_name, b.slug as band_slug
    FROM songs s
    JOIN bands b ON b.id = s.band_id
    WHERE s.id = ${id}
`;

if (!song) {
    return Astro.redirect('/');
}

let highlightedYml = '';
if (song.song_yml) {
    const highlighter = await highlighterPromise;
    highlightedYml = highlighter.codeToHtml(song.song_yml, {
        lang: 'yaml',
        theme: 'github-light'
    });
}
---

<Layout title={song.title}>
    <div class="mb-4">
        <a href={`/${song.band_slug}/songbook`} class="text-blue-600 hover:underline">
            ← Retour à {song.band_name}
        </a>
    </div>

    <h1 class="text-2xl font-bold mb-2">{song.title}</h1>
    <p class="text-gray-600 mb-6">{song.artist} • {song.tempo} bpm</p>

    {song.song_yml ? (
        <div class="rounded overflow-x-auto text-sm" set:html={highlightedYml} />
    ) : (
        <p class="text-gray-500 italic">Aucun contenu YAML disponible.</p>
    )}
</Layout>
