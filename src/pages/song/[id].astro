---
import Layout from '../../layouts/Layout.astro';
import { sql } from '../../db';

export const prerender = false;

const { id } = Astro.params;

const [song] = await sql`
    SELECT s.*, b.name as band_name, b.slug as band_slug
    FROM songs s
    JOIN bands b ON b.id = s.band_id
    WHERE s.id = ${id}
`;

if (!song) {
    return Astro.redirect('/');
}
---

<Layout title={song.title}>
    <div class="mb-4">
        <a href={`/${song.band_slug}/songbook`} class="text-blue-600 hover:underline">
            ← Retour à {song.band_name}
        </a>
    </div>

    <h1 class="text-2xl font-bold mb-2">{song.title}</h1>
    <p class="text-gray-600 mb-4">{song.artist} • {song.tempo} bpm</p>

    <div class="mb-4">
        <button
            id="saveBtn"
            class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 disabled:opacity-50"
            disabled
        >
            Enregistrer
        </button>
        <span id="status" class="ml-4 text-gray-600"></span>
    </div>

    <textarea
        id="yamlEditor"
        class="w-full h-[600px] font-mono text-sm bg-gray-900 text-gray-100 p-4 rounded border-0 focus:ring-2 focus:ring-blue-500"
        spellcheck="false"
    >{song.song_yml || ''}</textarea>
</Layout>

<script define:vars={{ songId: song.id }}>
    const editor = document.getElementById('yamlEditor');
    const saveBtn = document.getElementById('saveBtn');
    const status = document.getElementById('status');

    let originalContent = editor.value;

    editor.addEventListener('input', () => {
        const hasChanges = editor.value !== originalContent;
        saveBtn.disabled = !hasChanges;
        if (hasChanges) {
            status.textContent = 'Modifications non enregistrées';
            status.className = 'ml-4 text-orange-600';
        } else {
            status.textContent = '';
        }
    });

    saveBtn.addEventListener('click', async () => {
        saveBtn.disabled = true;
        status.textContent = 'Enregistrement...';
        status.className = 'ml-4 text-gray-600';

        try {
            const response = await fetch('/api/songs', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: songId,
                    song_yml: editor.value
                })
            });

            const result = await response.json();

            if (result.success) {
                originalContent = editor.value;
                status.textContent = 'Enregistré ✓';
                status.className = 'ml-4 text-green-600';
                setTimeout(() => {
                    status.textContent = '';
                }, 2000);
            } else {
                throw new Error(result.error);
            }
        } catch (error) {
            status.textContent = 'Erreur: ' + error.message;
            status.className = 'ml-4 text-red-600';
            saveBtn.disabled = false;
        }
    });
</script>
