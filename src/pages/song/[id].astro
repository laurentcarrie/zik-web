---
import Layout from '../../layouts/Layout.astro';
import { sql } from '../../db';

export const prerender = false;

const { id } = Astro.params;

const [song] = await sql`
    SELECT s.*, b.name as band_name, b.slug as band_slug
    FROM songs s
    JOIN bands b ON b.id = s.band_id
    WHERE s.id = ${id}
`;

if (!song) {
    return Astro.redirect('/');
}
---

<Layout title={song.title}>
    <div class="mb-4">
        <a href={`/${song.band_slug}/songbook`} class="text-blue-600 hover:underline">
            ← Retour à {song.band_name}
        </a>
    </div>

    <h1 class="text-2xl font-bold mb-2">{song.title}</h1>
    <p class="text-gray-600 mb-4">{song.artist} • {song.tempo} bpm</p>

    <div class="mb-4 flex gap-2">
        <button
            id="saveBtn"
            class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 disabled:opacity-50"
            disabled
        >
            Enregistrer
        </button>
        <span id="status" class="ml-4 text-gray-600 self-center"></span>
    </div>

    <div id="editor" class="rounded overflow-hidden"></div>
    <textarea id="yamlContent" class="hidden">{song.song_yml || ''}</textarea>
</Layout>

<script>
    import { EditorView, basicSetup } from 'codemirror';
    import { EditorState } from '@codemirror/state';
    import { yaml } from '@codemirror/lang-yaml';
    import { oneDark } from '@codemirror/theme-one-dark';

    const container = document.getElementById('editor');
    const yamlContent = document.getElementById('yamlContent') as HTMLTextAreaElement;
    const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLSpanElement;
    const songId = parseInt(window.location.pathname.split('/').pop() || '0');

    const originalContent = yamlContent.value;
    let currentContent = originalContent;

    const updateListener = EditorView.updateListener.of((update) => {
        if (update.docChanged) {
            currentContent = update.state.doc.toString();
            const hasChanges = currentContent !== originalContent;
            saveBtn.disabled = !hasChanges;
            if (hasChanges) {
                status.textContent = 'Modifications non enregistrées';
                status.className = 'ml-4 text-orange-600 self-center';
            } else {
                status.textContent = '';
            }
        }
    });

    const state = EditorState.create({
        doc: yamlContent.value,
        extensions: [
            basicSetup,
            yaml(),
            oneDark,
            updateListener,
            EditorView.theme({
                '&': { height: '600px' },
                '.cm-scroller': { overflow: 'auto' }
            })
        ]
    });

    const view = new EditorView({
        state,
        parent: container!
    });

    saveBtn.addEventListener('click', async () => {
        saveBtn.disabled = true;
        status.textContent = 'Enregistrement...';
        status.className = 'ml-4 text-gray-600 self-center';

        try {
            const response = await fetch('/api/songs', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: songId,
                    song_yml: currentContent
                })
            });

            const result = await response.json();

            if (result.success) {
                status.textContent = 'Enregistré ✓';
                status.className = 'ml-4 text-green-600 self-center';
                setTimeout(() => {
                    status.textContent = '';
                }, 2000);
            } else {
                throw new Error(result.error);
            }
        } catch (error: any) {
            status.textContent = 'Erreur: ' + error.message;
            status.className = 'ml-4 text-red-600 self-center';
            saveBtn.disabled = false;
        }
    });
</script>
