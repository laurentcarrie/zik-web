---
import Layout from '../../layouts/Layout.astro';
import { sql, getBandBySlug, getSongsByBand, getConcertsByBand } from '../../db';

export const prerender = false;

// Fetch band data
const band = await getBandBySlug('sunny-bd');
const songs = band ? await getSongsByBand(band.id) : [];
const concerts = band ? await getConcertsByBand(band.id) : [];
---

<Layout title="Sunny Bd">
    <h1 class="mb-10">Sunny Bd</h1>

    <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">Concerts</h2>
        {concerts.length > 0 ? (
            <ul class="list-disc pl-6">
                {concerts.map((concert) => (
                    <li>
                        <p>
                            {concert.name} {concert.venue && `@ ${concert.venue}`}
                            {concert.date && ` - ${new Date(concert.date).toLocaleDateString('fr-FR')}`}
                            {concert.pdf_url && (
                                <a href={concert.pdf_url} target="_blank" class="text-blue-600 hover:underline ml-2">
                                    (PDF)
                                </a>
                            )}
                        </p>
                    </li>
                ))}
            </ul>
        ) : (
            <p class="text-gray-500 italic">Aucun concert prévu pour le moment.</p>
        )}
    </section>

    <section class="mb-10">
        <h2 class="text-xl font-bold mb-4">Répertoire ({songs.length} chansons)</h2>
        {songs.length > 0 ? (
            <table class="w-full border-collapse">
                <thead>
                    <tr class="border-b">
                        <th class="text-left p-2">Titre</th>
                        <th class="text-left p-2">Artiste</th>
                        <th class="text-left p-2">Tonalité</th>
                        <th class="text-left p-2">Tempo</th>
                    </tr>
                </thead>
                <tbody>
                    {songs.map((song) => (
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-2">{song.title}</td>
                            <td class="p-2">{song.artist || '-'}</td>
                            <td class="p-2">{song.key || '-'}</td>
                            <td class="p-2">{song.tempo ? `${song.tempo} bpm` : '-'}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        ) : (
            <p class="text-gray-500 italic">Aucune chanson dans le répertoire pour le moment.</p>
        )}
    </section>
</Layout>
