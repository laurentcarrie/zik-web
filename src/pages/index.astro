---
import Grid from '@mui/material/Grid';

import Layout from '../layouts/Layout.astro';
import SongbookCard from '../components/SongbookCard.astro';

const songbooks = [
    {
        title: 'Move The Line',
        image: '/images/Move-the-line-affiche.jpg',
        songbookUrl: '/move-the-line/songbook',
        strudelUrl: '/move-the-line/strudel',
    },
    {
        title: 'Sunny Bd',
        image: '/images/sunny-bd.jpg',
        songbookUrl: '/sunny-bd/songbook',
        strudelUrl: '/sunny-bd/strudel',
    },
];
---

<Layout title="Bienvenue chez Laurent.">
    <h1 class="mb-10">les song books de Laurent</h1>

    <Grid container spacing={4} justifyContent="center">
        {songbooks.map((book) => (
            <Grid size={4}>
                <SongbookCard
                    title={book.title}
                    image={book.image}
                    imageAlt={book.title}
                    songbookUrl={book.songbookUrl}
                    strudelUrl={book.strudelUrl}
                />
            </Grid>
        ))}
    </Grid>
</Layout>
