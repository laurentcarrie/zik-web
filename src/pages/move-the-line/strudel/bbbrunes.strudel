
await initHydra()

// visuel graphique
// osc(10, 0.9, 300).color(0.9, 0.7, 0.8).diff(osc(45, 0.3, 100).color(0.9, 0.9, 0.9).rotate(0.18).pixelate(12).kaleid()).scrollX(10).colorama().luma().repeatX(4).repeatY(4).modulate(osc(1, -0.9, 300)).scale(2).out()

osc().modulateRotate(o0,0.3).out()
osc(33,0.3,0.3).diff(o3,3).out(o1)
osc(3,0.3,33).modulateKaleid(o3,3).diff(o0).out(o2)
src(o0,3).mult(o1,3).kaleid(3).out(o3)
render(o2)

// tempo
setcpm(120/4)


const row_1 = `
d2 - d2 - - - - - 
d2 - d2 - - - - - 
b1 - b1 - - - - - 
b1 - b1 - - - - - 
`

const row_13 = `
g1 - g1 - - - - - 
a1 - a1 - - - - - 
b1 - b1 - - - - - 
a1 - a1 - - - - - 
`
const row_17 = `
g1 - g1 - - - - - 
a1 - a1 - - - - - 
d2 - - - - - - - 
- - - - - - - - 
 
`




const intro=row_1
const couplet1=cat(row_1,row_1,row_13,row_17)

const basse = new stack(
note(couplet1.slow(4))
)
  .sound("gm_synth_bass_1")
  .gain(2)
  .color("red").punchcard({label:"bass"})


$: basse

// batterie
$: sound("[bd sd bd sd], [~ hh]*4")
.bank("Linn9000").color("blue")
