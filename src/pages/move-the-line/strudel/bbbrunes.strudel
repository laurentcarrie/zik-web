
await initHydra()

// visuel graphique
// osc(10, 0.9, 300).color(0.9, 0.7, 0.8).diff(osc(45, 0.3, 100).color(0.9, 0.9, 0.9).rotate(0.18).pixelate(12).kaleid()).scrollX(10).colorama().luma().repeatX(4).repeatY(4).modulate(osc(1, -0.9, 300)).scale(2).out()

// tempo
setcpm(120/4)


const row_1 = `
d2 - d2 - - - - - 
d2 - d2 - - - - - 
b1 - b1 - - - - - 
b1 - b1 - - - - - 

`

const row_13 = `
g1 - g1 - - - - - 
a1 - a1 - - - - - 
b1 - b1 - - - - - 
a1 - a1 - - - - - 
`
const row_17 = `
g1 - g1 - - - - - 
a1 - a1 - - - - - 
d2 - - - - - - - 
- - - - - - - - 
` 

const row_21 = `
g1 - g1 - a1 - a1 - 
d2 - d2 - d2 - d2 - 
g1 - g1 - a1 - a1 - 
b1 - b1 - b1 - b1 - 
`

const row_25 = `
a1 - a1 - a1 - a1 - 
a1 - a1 - a1 - a1 - 
g1 - g1 - g1 - g1 - 
g1 - g1 - g1 - g1 - 
`






const intro=row_1
const couplet1=cat(row_1,row_1,row_13,row_17)
const refrain1=cat(row_21,row_25)
const chanson=cat(intro,couplet1,refrain1)

const basse = new stack(
note(chanson.slow(64))
)
  .sound("gm_synth_bass_1")
  .gain(2)
  .color("red").punchcard({label:"bass"})


$: basse

drums: sound("bd - sd - bd - sd -").bank(
'Linn9000'
)
