---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    image: string;
    imageAlt: string;
    songbookUrl: string;
    strudelUrl: string;
}

const { title, image, imageAlt, songbookUrl, strudelUrl } = Astro.props;
---

<div class="flex flex-col items-center">
    <figure class="mb-4">
        <Image
            src={image}
            alt={imageAlt}
            class="rounded-lg"
            height={300}
            width={300}
        />
        <figcaption class="text-center mt-2 text-lg">{title}</figcaption>
    </figure>
    <ul class="flex flex-col gap-2">
        <li>
            <a href={songbookUrl} class="btn btn-lg sm:min-w-64">
                {title} song book
            </a>
        </li>
        <li>
            <a href={strudelUrl} class="btn btn-lg sm:min-w-64">
                strudel
            </a>
        </li>
    </ul>
</div>
