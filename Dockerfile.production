# Stage 1: Build React frontend
FROM node:22-slim AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: Build Rust backend
FROM rust:1.88-slim-bookworm AS rust-builder

RUN apt-get update && apt-get install -y pkg-config libfontconfig1-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY zik-web/Cargo.toml zik-web/Cargo.lock* ./
COPY zik-web/src ./src

RUN cargo build --release

# Stage 3: Production image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libfontconfig1 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Rust binary
COPY --from=rust-builder /app/target/release/zik-web /usr/local/bin/zik-web

# Copy static assets
COPY zik-web/static ./static

# Copy React build output
COPY --from=frontend-builder /app/frontend/dist ./dist

EXPOSE 8080

CMD ["zik-web"]
